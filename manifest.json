{
  "author": "Fob Widget",
  "id": "com.dmz.fob-widget",
  "name": "DMZ Fob",
  "description": "Tactical dashboard with map, printer and guides tabs",
  "version": "1.0.0",
  "preview_icon": "resources/preview.png",
  "min_framework_version": "1.0.0",
  "min_app_version": "5.47",
  "os": [
    {
      "platform": "windows"
    }
  ],
  "supported_devices": [
    {
      "type": "dashboard_lcd"
    }
  ],
  "interactive": true,
  "modules": [
    "modules/app.mjs",
    "modules/map.mjs",
    "modules/printer.mjs",
    "modules/guides.mjs"
  ],
  "permissions": [
    {
      "type": "url",
      "domain": "codcentral.net",
      "port": 443
    }
  ]
}
